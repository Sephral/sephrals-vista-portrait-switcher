{
  "id": "sephrals-vista-portrait-switcher",
  "title": "Sephral’s Vista Portrait Switcher",
  "description": "Switch the portrait a character shows in Ember's Vista scenes on the fly: a gallery of poses and moods per character, a palette in the token HUD, hotkeys, light variants and a soft transition – for players and the GM.",
  "version": "1.0.0",
  "compatibility": {
    "minimum": 14,
    "verified": "14.368"
  },
  "authors": [
    {
      "name": "Sephral"
    }
  ],
  "url": "https://github.com/Sephral/sephrals-vista-portrait-switcher.git",
  "relationships": {
    "requires": [
      {
        "id": "ember",
        "type": "module",
        "compatibility": {
          "minimum": "0.6.0",
          "verified": "0.6.2"
        }
      }
    ]
  },
  "esmodules": [
    "scripts/svps.mjs"
  ],
  "styles": [
    "styles/svps.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "de",
      "name": "Deutsch",
      "path": "lang/de.json"
    }
  ]
}
