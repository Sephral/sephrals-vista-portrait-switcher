{
  "id": "sephrals-vista-portrait-switcher",
  "title": "Sephral’s Vista Portrait Switcher",
  "description": "Switch the portrait an NPC shows in Ember's Vista scenes on the fly: a gallery with any number of portraits per character, a palette in the token HUD and a soft transition. Made for the GM, optional for players.",
  "version": "1.0.0",
  "compatibility": {
    "minimum": 14,
    "verified": "14.369"
  },
  "authors": [
    {
      "name": "Sephral"
    }
  ],
  "url": "https://github.com/Sephral/sephrals-vista-portrait-switcher.git",
  "relationships": {
    "requires": [
      {
        "id": "ember",
        "type": "module",
        "compatibility": {
          "minimum": "0.6.0",
          "verified": "0.6.3"
        }
      }
    ]
  },
  "esmodules": [
    "scripts/svps.mjs"
  ],
  "styles": [
    "styles/svps.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "de",
      "name": "Deutsch",
      "path": "lang/de.json"
    }
  ]
}
